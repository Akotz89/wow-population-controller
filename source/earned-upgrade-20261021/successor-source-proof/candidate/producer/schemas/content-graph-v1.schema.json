{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.playerbots.invalid/schemas/content-graph-v1.schema.json",
  "title": "Playerbots effective realm content graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "core_revision", "playerbots_revision", "progression_revision", "content_revision", "world_dump_digest", "dbc_set_digest", "availability_model", "nodes", "condition_roots", "edges"],
  "properties": {
    "schema_version": { "const": "cpi-207-content-graph-v1" },
    "core_revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "playerbots_revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "progression_revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "content_revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "world_dump_digest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "dbc_set_digest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "availability_model": { "const": "realm_frontier+phase_mask+spawn_mask+event_pool+condition_ast" },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quests", "items", "creatures", "gameobjects", "spells", "trainers", "vendors", "taxi_nodes", "areas", "maps", "dungeons", "loot_templates", "recipes"],
      "properties": {
        "quests": { "$ref": "#/$defs/node_array" },
        "items": { "$ref": "#/$defs/node_array" },
        "creatures": { "$ref": "#/$defs/node_array" },
        "gameobjects": { "$ref": "#/$defs/node_array" },
        "spells": { "$ref": "#/$defs/node_array" },
        "trainers": { "$ref": "#/$defs/node_array" },
        "vendors": { "$ref": "#/$defs/node_array" },
        "taxi_nodes": { "$ref": "#/$defs/node_array" },
        "areas": { "$ref": "#/$defs/node_array" },
        "maps": { "$ref": "#/$defs/node_array" },
        "dungeons": { "$ref": "#/$defs/node_array" },
        "loot_templates": { "$ref": "#/$defs/node_array" },
        "recipes": { "$ref": "#/$defs/node_array" }
      }
    },
    "condition_roots": {
      "type": "array", "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id", "expression"],
        "properties": {
          "condition_id": { "$ref": "common-v1.schema.json#/$defs/stable_id" },
          "expression": { "$ref": "#/$defs/condition_expression" }
        }
      }
    },
    "edges": {
      "type": "array", "maxItems": 5000000,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "availability": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_frontier", "maximum_frontier", "phase_mask", "spawn_mask", "event_ids", "pool_ids", "condition_id"],
      "properties": {
        "minimum_frontier": { "type": "integer", "minimum": 1, "maximum": 80 },
        "maximum_frontier": { "type": "integer", "minimum": 1, "maximum": 80 },
        "phase_mask": { "$ref": "common-v1.schema.json#/$defs/uint32" },
        "spawn_mask": { "$ref": "common-v1.schema.json#/$defs/uint32" },
        "event_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/uint32" } },
        "pool_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/uint32" } },
        "condition_id": { "anyOf": [{ "$ref": "common-v1.schema.json#/$defs/stable_id" }, { "type": "null" }] }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "availability", "attributes"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/uint32" },
        "availability": { "$ref": "#/$defs/availability" },
        "attributes": { "type": "object" }
      }
    },
    "node_array": { "type": "array", "maxItems": 2000000, "items": { "$ref": "#/$defs/node" } },
    "condition_expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "arguments"],
          "properties": {
            "op": { "enum": ["all", "any"] },
            "arguments": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/condition_expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "argument"],
          "properties": { "op": { "const": "not" }, "argument": { "$ref": "#/$defs/condition_expression" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "condition_type", "values"],
          "properties": {
            "op": { "const": "leaf" },
            "condition_type": { "$ref": "common-v1.schema.json#/$defs/uint32" },
            "values": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "common-v1.schema.json#/$defs/uint32" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "condition_id"],
          "properties": { "op": { "const": "reference" }, "condition_id": { "$ref": "common-v1.schema.json#/$defs/stable_id" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op"],
          "properties": { "op": { "enum": ["true", "false", "indeterminate"] } }
        }
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "kind", "from", "to", "semantics", "availability", "attributes", "provenance"],
      "properties": {
        "edge_id": { "$ref": "common-v1.schema.json#/$defs/stable_id" },
        "kind": { "enum": ["quest_starter", "quest_ender", "quest_objective", "quest_prerequisite", "quest_continuation", "quest_breadcrumb", "quest_exclusive_group", "quest_reward", "loot_source", "loot_reference", "vendor_source", "trainer_spell", "recipe_reagent", "recipe_product", "taxi_path", "travel_anchor", "dungeon_member", "dungeon_quest"] },
        "from": { "$ref": "common-v1.schema.json#/$defs/content_ref" },
        "to": { "$ref": "common-v1.schema.json#/$defs/content_ref" },
        "semantics": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$", "maxLength": 160 },
        "availability": { "$ref": "#/$defs/availability" },
        "attributes": { "type": "object" },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "natural_key"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "maxLength": 240 },
            "natural_key": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": ["integer", "string"] } }
          }
        }
      }
    }
  }
}
