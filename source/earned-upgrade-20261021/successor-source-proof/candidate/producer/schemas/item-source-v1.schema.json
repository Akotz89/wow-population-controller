{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.playerbots.invalid/schemas/item-source-v1.schema.json",
  "title": "Playerbots earned item-source graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_revision", "graph_digest", "item_id", "sources"],
  "properties": {
    "schema_version": { "const": "cpi-207-item-source-v1" },
    "content_revision": { "$ref": "common-v1.schema.json#/$defs/revision" },
    "graph_digest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "item_id": { "$ref": "common-v1.schema.json#/$defs/uint32" },
    "sources": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_kind", "source_ref", "minimum_count", "maximum_count", "chance_numerator", "chance_denominator", "minimum_phase", "maximum_phase", "required_group_size", "money_cost_copper", "travel_seconds", "seconds_per_attempt", "risk_milli", "contention_milli", "required_capabilities", "required_profession_skill_id", "required_profession_skill_value", "quest_alternative_group", "craft_dependencies", "condition_root", "earned"],
        "properties": {
          "source_id": { "$ref": "common-v1.schema.json#/$defs/stable_id" },
          "source_kind": { "enum": ["quest_reward", "creature_loot", "gameobject_loot", "vendor", "trainer_recipe", "craft", "pvp_reward", "dungeon_quest", "dungeon_drop", "disenchant", "prospecting", "milling", "fishing", "skinning"] },
          "source_ref": { "$ref": "common-v1.schema.json#/$defs/content_ref" },
          "minimum_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "maximum_count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "chance_numerator": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "chance_denominator": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "minimum_phase": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "maximum_phase": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "required_group_size": { "type": "integer", "minimum": 1, "maximum": 40 },
          "money_cost_copper": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "travel_seconds": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "seconds_per_attempt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "risk_milli": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "contention_milli": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "required_capabilities": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 160 } },
          "required_profession_skill_id": { "$ref": "common-v1.schema.json#/$defs/uint32" },
          "required_profession_skill_value": { "type": "integer", "minimum": 0, "maximum": 450 },
          "quest_alternative_group": { "anyOf": [{ "$ref": "common-v1.schema.json#/$defs/stable_id" }, { "type": "null" }] },
          "craft_dependencies": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["item_id", "count", "available", "phase_authorized", "earned"],
              "properties": {
                "item_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "available": { "type": "boolean" },
                "phase_authorized": { "type": "boolean" },
                "earned": { "const": true }
              }
            }
          },
          "condition_root": { "type": ["string", "null"], "maxLength": 160 },
          "earned": { "const": true }
        }
      }
    }
  }
}
